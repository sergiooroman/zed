#!/usr/bin/env bash
# Merges an upstream release branch and resolves the conflicts that need no
# judgement, leaving only the ones that do.
#
# Zed keeps each release line on its own branch rather than one cumulative line,
# so the backports this fork already carries conflict with files it has never
# customized. Those are noise: the fork has no opinion about them and upstream's
# side is simply correct. Deciding that per file is mechanical — ask git whether
# any fork commit ever touched the file — so do it here rather than spending an
# agent's whole budget re-deriving it, which is what happened when the sync was
# handed over wholesale and never got as far as opening a pull request.
#
# Usage: script/sync-upstream-merge <upstream-release-ref> [upstream-remote]
# Leaves the merge in progress. Prints the files still conflicted, if any.

set -uo pipefail
cd "$(dirname "$0")/.."

release_ref="${1:?usage: sync-upstream-merge <upstream-release-ref> [upstream-remote]}"
upstream_remote="${2:-upstream}"

git merge --no-commit --no-ff "$release_ref" >/dev/null 2>&1

# The fork keeps its own CI, so upstream's workflow files stay frozen at
# whatever the fork already carries. Two reasons. The token the sync agent
# pushes with has no `workflows` permission, so GitHub refuses any push that
# touches .github/workflows at all — the v1.18.1 and v1.20.1 syncs each had to
# revert those files by hand just to get the merge pushed. And none of that
# CI is the fork's to run anyway: it is Zed's triage, guild and release
# machinery. Restore ours over any change or conflict, and drop what upstream
# added, so the merge pushes clean and no PR carries a "still to apply" note.
workflow_changes="$(git diff --name-only --cached -- .github/workflows; git diff --name-only --diff-filter=U -- .github/workflows)"
if [[ -n "$workflow_changes" ]]; then
    git checkout HEAD -- .github/workflows 2>/dev/null || true
    while IFS= read -r added; do
        [[ -n "$added" ]] && git rm -q --cached -- "$added" 2>/dev/null && rm -f -- "$added"
    done < <(git diff --name-only --cached --diff-filter=A -- .github/workflows)
    echo "Kept the fork's .github/workflows as they were (upstream's CI is not tracked)."
fi

# Read with a loop rather than mapfile: macOS still ships bash 3.2, which has
# neither mapfile nor readarray, and this script is run by hand as often as by CI.
conflicted=()
n_conflicted=0
while IFS= read -r line; do
    [[ -n "$line" ]] && conflicted+=("$line") && n_conflicted=$((n_conflicted + 1))
done < <(git diff --name-only --diff-filter=U)

if [[ $n_conflicted -eq 0 ]]; then
    echo "Merged cleanly; nothing to resolve."
    exit 0
fi

# The upstream release this fork last integrated. A conflicted file whose
# content at HEAD is byte-identical to that release carries nothing of ours,
# whatever its history says.
last_synced="$(git describe --tags --match 'v[0-9]*' --abbrev=0 HEAD 2>/dev/null || true)"

taken=()
remaining=()
n_taken=0
n_remaining=0
for file in ${conflicted[@]+"${conflicted[@]}"}; do
    # Two ways a file can be shown to carry no fork change. By content: it is
    # identical to the last synced upstream release. By history: no commit
    # outside upstream's refs ever touched it. The content test is needed
    # because a sync's own merge commit "touches" every file it resolved, so
    # after one sync the history test alone flags files we merely took from
    # upstream last time, and they would need judgement forever.
    # The history test excludes EVERY upstream ref, not just the branch being
    # merged: this fork carries earlier release lines, whose commits are
    # upstream's too, and excluding only the target branch counted them as ours.
    if { [[ -n "$last_synced" ]] && git diff --quiet "$last_synced" HEAD -- "$file"; } \
        || [[ -z "$(git log --oneline HEAD --not --remotes="$upstream_remote" -- "$file")" ]]; then
        git checkout --theirs -- "$file" 2>/dev/null && git add -- "$file" && taken+=("$file") && n_taken=$((n_taken + 1))
    else
        remaining+=("$file")
        n_remaining=$((n_remaining + 1))
    fi
done

echo "Conflicts: $n_conflicted total"
if [[ $n_taken -gt 0 ]]; then
    echo "Resolved to upstream (untouched by this fork): $n_taken"
    printf '  %s\n' ${taken[@]+"${taken[@]}"}
fi
if [[ $n_remaining -eq 0 ]]; then
    echo "Nothing left needing judgement."
    exit 0
fi
echo "Still conflicted — these carry fork changes and need a decision:"
printf '  %s\n' ${remaining[@]+"${remaining[@]}"}
exit 10
